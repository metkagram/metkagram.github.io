{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metkagram.github.io/data/schemas/search-opportunity-clusters.schema.json",
  "title": "Metkagram search opportunity clusters",
  "description": "Privacy-safe editorial learner-intent clusters that can receive aggregate non-brand search metrics without storing raw queries.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "evidenceBoundary", "clusters"],
  "properties": {
    "schemaVersion": {"const": 1},
    "status": {"const": "editorial-pilot"},
    "evidenceBoundary": {"type": "string", "minLength": 1},
    "clusters": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label_en", "learner_job_en", "topic_id", "set_ids", "review_status", "provenance"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "label_en": {"type": "string", "minLength": 1},
          "learner_job_en": {"type": "string", "minLength": 1},
          "topic_id": {"type": "string", "minLength": 1},
          "set_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "review_status": {"const": "editorial"},
          "provenance": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
